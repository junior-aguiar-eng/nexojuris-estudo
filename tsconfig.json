{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true, "noEmit": true, "module": "esnext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "allowImportingTsExtensions": true, "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
